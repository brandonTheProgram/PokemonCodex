<% if (pokemon != null) { %>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active" aria-current="page"><%- pokemon.name %>  </li>
        </ol>
    </nav>

    <div class="row">
        <!-- Display the Pokemon's Image -->
        <div class="col-12 col-md-4">
            <img src="<%= pokemon.image %>" class="img-fluid sticky-top" style="top: 20px" alt=<%- pokemon.name %> loading="lazy">
        </div>

        <!-- Display the Pokemon's pokedex num, name, species, and typing -->
        <div class="col-12 col-md-8">
            <div class="row">
              <div class="col-sm">
                <h3>#<%- pokemon.pokedex_number %> <%- pokemon.name %></h3>
              </div>
              <div class="col-sm">
                <h3>Species:<br><%- pokemon.species %></h3>
              </div>
              <% if ( !pokemon.secondary_type) { %> 
                <div class="col-sm">
                    <h3>Type: <%- pokemon.primary_type %></h3>
                </div>
              <% } else { %>
                <div class="col-sm">
                    <h3>Type: <%- pokemon.primary_type %> & <%- pokemon.secondary_type %></h3>
                </div>
              <% } %> 
            </div>
        </div>

        <!-- Display the Pokemon's description -->
        <div class="container">
          <h3>Description</h3>
          <div class="row">
            <%- pokemon.description %>
          </div>
        </div>

        <p></p>

        <!-- Display the Pokemon's abilities -->
        <div class="container">
            <h3>Abilities</h3>
            <div class="row">
                <%- pokemon.primary_ability  %>
            </div>
            <% if ( pokemon.secondary_ability) { %>
                <div class="row">
                    <%- pokemon.secondary_ability %>
                </div>
            <% } %>
            <% if ( pokemon.hidden_ability) { %>
                <div class="row">
                    (Hidden) <%- pokemon.hidden_ability %>
                </div> 
            <% } %>
            <br>
        </div>

        <!-- Display the Pokemon's type effectiveness -->
        <% if (pokemonTypes != null) { %>
          <table>
            <h3>Weakness</h3>
            <thead>
                <tr>
                  <% pokemonTypes.forEach(pokemonType => { %>
                    <th><%= pokemonType.name %></th>
                  <% }); %>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <% pokemon.type_effectiveness.forEach(effectiveness => { %>
                        <td class="<% if (effectiveness.damage_multiplier === 2) { %>twice_damage<%} else if (effectiveness.damage_multiplier === 1) { %>normal_damge<%} else if (effectiveness.damage_multiplier === 0.5) { %>half_damage<%} else if (effectiveness.damage_multiplier === 0.25) { %>quarter_damage<%} else { %>no_damage<%} %>">
                          <%= effectiveness.damage_multiplier %>
                        </td>
                    <% }); %>
                </tr>
            </tbody>
          </table>
        <% } %>

        <!-- Display the Pokemon's evolutionary line -->
    </div>
<% } else { %> 
    <p>No Pokemon Found</p>
<% } %> 