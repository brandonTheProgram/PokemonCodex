<% if (Object.keys(pokemon).length != 0) { %>

  <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%- pokemon.name %>  </li>
      </ol>
  </nav>

  <!-- Navigation Buttons for Next and Previous Pokémon -->
  <div class="d-flex justify-content-between mb-3">
    <% let prevPokedexNumber = parseInt(pokemon.pokedex_number) - 1; %>
    <% if (prevPokedexNumber > 0) { %>
      <a href="/pokemon/<%= prevPokedexNumber %>" class="btn btn-primary">
        Previous Pokémon (#<%= prevPokedexNumber %>)
      </a>
    <% } %>
    <% let nextPokedexNumber = parseInt(pokemon.pokedex_number) + 1; %>
    <a href="/pokemon/<%= nextPokedexNumber %>" class="btn btn-success">
        Next Pokémon (#<%= nextPokedexNumber %>)
    </a>
  </div>

  <div class="row">
    <!-- Pokémon sprite, name, and types -->
    <div class="table-wrap table-summary mb-3 p-3">
      <div class="row align-items-center">
        <!-- Pokémon sprite -->
        <div class="col-md-4 text-center mb-3 mb-md-0">
          <img src="<%= pokemon.image %>" class="img-fluid" alt="<%- pokemon.name %>"
              loading="lazy" decoding="async" style="max-height: 220px;">
        </div>

        <!-- Name, species, types -->
        <div class="col-md-8">
          <table class="table table-kv mb-0">
            <tbody>
              <tr>
                <th scope="row">National #</th>
                <td><%= pokemon.pokedex_number %></td>
              </tr>
              <tr>
                <th scope="row">Name</th>
                <td><%= pokemon.name %></td>
              </tr>
              <tr>
                <th scope="row">Species</th>
                <td><%= pokemon.species %></td>
              </tr>
              <tr>
                <th scope="row">Type(s)</th>
                <td class="badge-row">
                  <% const priType = pokemon.primary_type.toString(); %>
                  <span class="type-badge type-<%= priType.toLowerCase() %>"><%= priType %></span>
                  <% if (pokemon.secondary_type) { %>
                    <% const secType = pokemon.secondary_type.toString(); %>
                    <span class="type-badge type-<%= secType.toLowerCase() %>"><%= secType %></span>
                  <% } %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Display the Pokemon's description and ability -->
    <div class="table-wrap table-info mb-4">
      <table class="table table-kv">
        <tbody>
          <tr>
            <th scope="row">Description</th>
            <td><%= pokemon.description %></td>
          </tr>
          <tr>
            <th scope="row">Abilities</th>
            <td>
              <div><%- pokemon.primary_ability %></div>
              <% if ( pokemon.secondary_ability) { %>
                  <div><%- pokemon.secondary_ability %></div>
              <% } %>
              <% if ( pokemon.hidden_ability) { %>
                <div>(Hidden) <%- pokemon.hidden_ability %></div>
              <% } %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Display the Pokemon's type effectiveness -->
    <% if (pokemonTypes != null) { %>
      <div class="container mt-4">
        <h3>Weakness</h3>
        <div class="table-wrap weakness-table">
          <table class="table table-striped">
            <thead>
              <tr>
                <% pokemonTypes.forEach(t => { const typeName = t.name || ''; %>
                  <th title="<%= typeName %>">
                    <span class="type-badge type-<%= typeName.toLowerCase() %>">
                      <span class="type-vert"><%= typeName %></span>
                    </span>
                  </th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <tr>
                <% pokemon.type_effectiveness.forEach(eff => {
                    const m = eff.damage_multiplier;
                    // map to badge class
                    let cls = 'mult-x1', label = `x${m}`;
                    if (m === 4)          cls = 'mult-x4';
                    else if (m === 2)     cls = 'mult-x2';
                    else if (m === 1)     cls = 'mult-x1';
                    else if (m === 0.5)   cls = 'mult-x0_5';
                    else if (m === 0.25)  cls = 'mult-x0_25';
                    else if (m === 0)     cls = 'mult-x0';
                %>
                  <td><span class="mult-badge <%= cls %>"><%= label %></span></td>
                <% }); %>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- Display the Pokemon's evolutionary line -->
    <div class="container text-center">
      <br>
      <% if (pokemon.evolutionary_line && pokemon.evolutionary_line.length > 0) { %>
        <div class="evo-container">
          <h3 class="text-start">Evolutionary Line</h3>
          <%- include('EvolutionLine', { edges: pokemon.evolutionary_line }) %>
        </div>
      <% } %>
    </div>      

    <!-- Pokémon Locations Section -->
    <% if (pokemon.game_locations && pokemon.game_locations.length > 0 && pokemonGames.length > 0) { %>
      <div class="container mt-4">
        <h3>Locations</h3>
        <div class="accordion" id="locationAccordion">
          <% pokemonGames.forEach((game, index) => { %>
            <div class="accordion-item">
              <h2 class="accordion-header" id="heading<%= index %>">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>" aria-expanded="false" aria-controls="collapse<%= index %>">
                  <span class="badge bg-primary me-2"><%= game.name %></span>
                </button>
              </h2>
              <div id="collapse<%= index %>" class="accordion-collapse collapse" aria-labelledby="heading<%= index %>" data-bs-parent="#locationAccordion">
                <div class="accordion-body">
                  <% if (pokemon.game_locations[index]) { %>
                    <p><%- pokemon.game_locations[index] %></p>
                  <% } else { %>
                    <p class="text-muted">No known location</p>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } else { %>
      <p class="text-muted">This Pokémon is not found in the wild in any game.</p>
    <% } %>

    <!-- Pokémon Level-Up Moveset Section -->
    <% if (pokemon.level_up_moveset && pokemon.level_up_moveset.length > 0 && pokemonMainlineGames.length > 0) { %>
      <div class="container mt-4">
        <h3>Level-Up Moveset</h3>
        <% pokemonMainlineGames.forEach((game, index) => { 
            const filteredMoves = pokemon.level_up_moveset.filter(m => m.mainline == game.id);
        %>
          <% if (filteredMoves.length > 0) { %>
            <%- include('MovesTable', {
              id: `levelup-${index}`,
              sectionTitle: 'Level-Up Moveset',
              badgeText: game.name,
              badgeClass: 'bg-success',
              rows: filteredMoves,
              firstColLabel: 'Level',
              firstColKey: 'level_learned'
            }) %>
          <% } %>
        <% }); %>
      </div>
    <% } %>

    <!-- Pokémon Technical Machines Section -->
    <% if (pokemon.technical_machines && pokemon.technical_machines.length > 0 && pokemonMainlineGames.length > 0) { %>
      <div class="container mt-4">
        <h3>Technical Machines (TMs)</h3>
        <% pokemonMainlineGames.forEach((game, index) => {
            const tms = pokemon.technical_machines.filter(m => m.mainline == game.id);
            const tmRows = tms.map(tm => ({
              move: tm.technical_move.move,
              technical_number: tm.technical_move.technical_number,
              mainline_game_id: tm.mainline
            }));
        %>
          <% if (tms.length > 0) { %>
            <%- include('MovesTable', {
              id: `tms-${index}`,
              sectionTitle: 'Technical Machines (TMs)',
              badgeText: game.name,
              badgeClass: 'bg-warning text-dark',
              rows: tmRows,
              firstColLabel: 'TM',
              firstColKey: 'technical_number'
            }) %>
          <% } %>
        <% }); %>
      </div>
    <% } %>

    <!-- Pokémon Technical Records Section -->
    <% if (pokemon.technical_records && pokemon.technical_records.length > 0 && pokemonMainlineGames.length > 0) { %>
      <div class="container mt-4">
        <h3>Technical Records (TRs)</h3>
        <% pokemonMainlineGames.forEach((game, index) => {
            const trs = pokemon.technical_records.filter(m => m.mainline == game.id);
            const trRows = trs.map(tr => ({
              move: tr.technical_move.move,
              technical_number: tr.technical_move.technical_number,
              mainline_game_id: tr.mainline
            }));
        %>
          <% if (trs.length > 0) { %>
            <%- include('MovesTable', {
              id: `trs-${index}`,
              sectionTitle: 'Technical Records (TRs)',
              badgeText: game.name,
              badgeClass: 'bg-info text-dark',
              rows: trRows,
              firstColLabel: 'TR',
              firstColKey: 'technical_number'
            }) %>
          <% } %>
        <% }); %>
      </div>
    <% } %>
  </div>
<% } else { %> 
  <div class="alert alert-warning text-center" role="alert">
    No Pokémon data found. Please try again or return to the <a href="/">homepage</a>.
  </div>
<% } %>
