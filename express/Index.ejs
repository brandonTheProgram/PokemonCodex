<head>
    <title>Home</title>
</head>
<!-- Header Start -->
<div class="row flex-lg-row-reverse align-items-center g-5 py-4 mb-4">
    <div class="col-12 col-lg-6">
        <img src="/icons/Pokedex.png" width="607" height="510" class="d-block mx-lg-auto img-fluid" loading="lazy" alt="Pokedex">
    </div>

    <div class="col-12 col-lg-6">

        <h1 class="display-5 fw-bold mb-3">Welcome to the world of Pokémon</h1>
        <p class="lead">
            Explore the the vast world of Pokémon by learning about the creatures that inhabit the world.
        </p>

    </div>

</div>
<!-- Header End -->

<!-- Regions Start -->
<div class="row row-cols-2 row-cols-lg-6 g-2 g-lg-3 py-4">

    <% if(regions != '') { %>
        <% regions.forEach(function(region, index, array) { %>
            <a href="/region/<%- region.name %>" class="col text-center region__link">
                <div class="region__img shadow">
                    <img src="<%= region.image %>" width="220" height="200"  alt=<%- region.name %> loading="lazy">
                </div>
                <% if(index === array.length - 1) { %>
                    <div class="pt-1"><%- region.name %> Regions</div>
                <% } else {%>
                    <div class="pt-1"><%- region.name %> Region</div>
                <% } %>
            </a>
        <% }) %>
    <% } %>
</div>
<!-- Regions End -->

<!-- Lastest Start -->
<section class="pb-4 pt-4">
    <div class="d-flex mb-2 align-items-center">
        <h2>Latest Pokemon</h2>
    </div>

    <div class="row row-cols-2 row-cols-lg-5 g-2 g-lg-3">
        <% if(latest != '') { %>
            <% latest.forEach(function(latestPokemon, index) { %>
                <a href="/pokemon/<%= latestPokemon.pokedex_number %><%= latestPokemon.region_id !== 'NULL' ? '/' + latestPokemon.region_id : '' %>" class="col text-center region__link">
                    <div class="pokemon__button shadow">
                        <img src="<%= latestPokemon.image %>" width="256" height="256"  alt=<%- latestPokemon.name %> loading="lazy" decoding="async">
                    </div>
                    <div class="pt-1">#<%- latestPokemon.pokedex_number %> <%- latestPokemon.name %></div>
                </a>
            <% }) %>
        <% } %>
    </div>
</section>
<!-- Lastest End -->

<!-- Starting Pokemon Start -->
<% if(regions != '') { %>
    <% regions.forEach(function(region, index) { %>
        <section class="pb-4 pt-4">
            <div class="d-flex mb-2 align-items-center">
                <h2><%- region.name %> Pokemon</h2>
                <a href="/region/<%- region.name %>" class="ms-auto">View More</a>
            </div>

            <div class="row row-cols-2 row-cols-lg-5 g-2 g-lg-3">
                <% if(startingPokemon[index]) { %>
                    <% startingPokemon[index].forEach(function(pokemon, index) { %>
                        <a href="/pokemon/<%= pokemon.pokedex_number %><%= pokemon.region_id !== 'NULL' ? '/' + pokemon.region_id : '' %>" class="col text-center region__link">
                            <div class="pokemon__button shadow">
                                <img src="<%= pokemon.image %>" width="256" height="256"  alt=<%- pokemon.name %> loading="lazy" decoding="async">
                            </div>
                            <div class="pt-1">#<%- pokemon.pokedex_number %> <%- pokemon.name %></div>
                        </a>
                    <% }) %>
                <% } %>
            </div>
        </section>
    <% }) %>
<% } %>
<!-- Starting End -->